[global]
    monitor = 0
    follow = none
    width = 300
    origin = top-right
    offset = (8, 11)
    scale = 1
    corner_radius = 0
    frame_width = 1
    frame_color = "#9e8e81"
    background = "#19120c"
    foreground = "#efe0d5"
    font = JetBrainsMono Nerd Font 10
    format = "<span foreground='#fdb975' font_desc='JetBrainsMono Nerd Font Bold 10'>%s</span>\n<span foreground='#efe0d5'>%b</span>"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    padding = 12
    horizontal_padding = 15
    text_icon_padding = 0
    icon_position = off
    separator_height = 1
    separator_color = "#9e8e81"
    show_indicators = no
    indicate_hidden = no

[urgency_low]
    frame_color = "#9e8e81"
    timeout = 5

[urgency_normal]
    frame_color = "#9e8e81"
    timeout = 5

[urgency_critical]
    frame_color = "#ffb4ab"
    background = "#19120c"
    foreground = "#efe0d5"
    timeout = 0
